# Environment variables for the Waytokaaba API in production (e.g. Render → Environment).
# ASP.NET Core maps "__" to ":" — e.g. Jwt__SigningKey overrides Jwt:SigningKey in appsettings.json.
# Local development does NOT need these: appsettings.Development.json + docker-compose provide everything.

ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL — either a URL (Neon/Render/Railway style) ...
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# ... or a standard Npgsql connection string (takes precedence if set):
# ConnectionStrings__DefaultConnection=Host=HOST;Port=5432;Database=DB;Username=USER;Password=PASSWORD;SSL Mode=Require

# Secret for signing admin JWTs — at least 32 random characters. Generate e.g. with:
#   openssl rand -base64 48
Jwt__SigningKey=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
Jwt__ExpiryMinutes=480

# Apply EF Core migrations automatically at startup (recommended for this MVP).
Database__ApplyMigrationsOnStartup=true
# Insert sample hotels/packages if the database is empty. Set to false for a clean production database.
Database__SeedDemoData=true

# First admin account, created at startup if it doesn't exist (password: 10+ characters).
Database__AdminEmail=admin@example.com
Database__AdminPassword=CHANGE_ME_STRONG_PASSWORD

# Comma-separated list of frontend origins allowed to call the API from a browser.
Cors__AllowedOrigins=https://your-site.vercel.app

# Optional tuning
# RateLimits__InquiriesPerMinute=5
# RateLimits__LoginsPer5Minutes=10
# Swagger__Enabled=true
# PORT=8080   (set automatically by Render)
