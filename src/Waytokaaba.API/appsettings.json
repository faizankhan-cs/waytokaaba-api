{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDemoData": false,
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "Jwt": {
    "Issuer": "waytokaaba-api",
    "Audience": "waytokaaba-admin",
    "SigningKey": "",
    "ExpiryMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": ""
  },
  "RateLimits": {
    "InquiriesPerMinute": 5,
    "LoginsPer5Minutes": 10
  },
  "Swagger": {
    "Enabled": true
  }
}
